# =====================================================================
# ShieldNet Backend — Modèle de configuration d'environnement (.env.example)
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement
# =====================================================================

# Clé secrète Django (Générez une clé aléatoire forte en production)
SECRET_KEY=django-insecure-shieldnet-uqo-secret-key-2026-synthese

# Mode débogage (True en dev, False en production)
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules si plusieurs)
ALLOWED_HOSTS=*

# Clé API partagée avec l'application mobile ShieldNet
API_KEY=ShieldNet_Secret_Token_UQO_2026

# Sel cryptographique pour le hachage HMAC-SHA256 (doit correspondre au mobile)
HASH_SALT=ShieldNet_Secure_Salt_2026_UQO

# Configuration Base de données (Laisser vide pour SQLite local par défaut)
# POSTGRES_DB=shieldnet_db
# POSTGRES_USER=shieldnet_user
# POSTGRES_PASSWORD=shieldnet_password_2026
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
